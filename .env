# Nhu Villas backend — local development environment (PostgreSQL profile)

# Database — PostgreSQL (active profile below)
# SPRING_PROFILES_ACTIVE=postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123456

# CORS — comma-separated origins allowed to call the API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# App
APP_BASE_URL=http://localhost:8080
APP_ADMIN_EMAIL=admin@hotel.com
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin@123
APP_BOOKING_DEADLINE_HOURS=24

# Email (Mailtrap for local dev, leave commented to skip real sending)
# spring.mail.host=sandbox.smtp.mailtrap.io
# spring.mail.port=2525
# spring.mail.username=
# spring.mail.password=

# Gemini AI — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6LJfnl7JMG84pleNlkJA74zgYrtkGeKMpO3E8BkrdFOYg
GEMINI_API_MODEL=gemini-2.0-flash

# Session security — set true behind HTTPS in production
SESSION_COOKIE_SECURE=false
