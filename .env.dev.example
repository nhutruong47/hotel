# Local development secrets for docker-compose.dev.yml.
#   cp .env.dev.example .env.dev
#   docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# Values here are for a laptop only. Production values never live in the repository.
DB_PASSWORD=dev-db-password
REDIS_PASSWORD=dev-redis-password
RABBITMQ_USER=nhu
RABBITMQ_PASSWORD=dev-rabbit-password
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Dev-Only-Admin-Pass-1!
APP_ADMIN_EMAIL=admin@localhost
APP_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Local email goes to Mailpit (http://localhost:8025).
NEXT_PUBLIC_API_URL=http://backend:8080/api/v1
