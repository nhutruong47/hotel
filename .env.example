# Nhu Villas — environment templates
#   .env.dev.example   -> docker-compose.dev.yml (everything in containers on a laptop)
#   .env.prod.example  -> docker-compose.prod.yml / staging on the VPS
#   this file          -> running the backend directly (mvnw spring-boot:run) against
#                         a local PostgreSQL with SPRING_PROFILES_ACTIVE=postgres
# Never commit real values; the real .env* files are git-ignored.

SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotel
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Redis / RabbitMQ (optional for local runs; the outbox retries until RabbitMQ is up)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
RABBITMQ_USER=nhu
RABBITMQ_PASSWORD=change-me
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_POLL_MS=5000
NOTIFICATION_OUTBOX_RETENTION_DAYS=7

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_ADMIN_EMAIL=admin@localhost
# Admin bootstrap: without these, no admin is created outside the explicit "dev" profile (R-11).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-to-a-strong-password
APP_BOOKING_HOLD_MINUTES=15
SEPAY_API_KEY=

# Gemini AI — https://aistudio.google.com/app/apikey (rotate any key that was ever committed)
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash

# --- Pricing / auth policy (ADR-0009) ---
# Surcharge per extra guest (from the 3rd guest) per night, in VND
APP_PRICING_EXTRA_GUEST_FEE=625000
# Only set true if no SMTP is configured AND you accept unverified accounts
APP_AUTH_AUTO_VERIFY_WITHOUT_EMAIL=false

# --- Frontend (build-time) ---
# One-click demo accounts on the login page: only for local/staging, never production.
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
# NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=<password of the seeded demo guests>
