# Nhu Villas backend — local development overrides
# Copy to a real .env file (not committed) or set as environment variables.
# When the `dev` Spring profile is active (default for local), these values
# are picked up automatically.

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# RabbitMQ Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Database
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=HotelDB;encrypt=false;trustServerCertificate=true
# Replace these with your local SQL Server credentials. The dev profile
# defaults to admin / admin@123 if nothing is set here.
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin@123

# CORS — comma-separated origins allowed to call the API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# App
APP_BASE_URL=http://localhost:5173
APP_ADMIN_EMAIL=admin@hotel.com
# Local convenience defaults - override in production. Username is
# only used the first time DataInitializer provisions the account.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin@123
APP_BOOKING_DEADLINE_HOURS=24

# Email (Mailtrap for local dev)
# spring.mail.host=sandbox.smtp.mailtrap.io
# spring.mail.port=2525
# spring.mail.username=...
# spring.mail.password=...

# Gemini AI — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-real-key-here
GEMINI_API_MODEL=gemini-2.0-flash

# Session security — set true behind HTTPS in production
SESSION_COOKIE_SECURE=false
