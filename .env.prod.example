# Production / staging template for docker-compose.prod.yml (ADR-0007).
#   cp .env.prod.example .env.prod   (on the VPS only; chmod 600 .env.prod)
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --no-build
# Generate secrets with: openssl rand -base64 32
# Compose refuses to start if a required value (marked REQUIRED) is missing.

# --- Public endpoint ---
SERVER_NAME=nhuvillas.example.com                     # REQUIRED: DNS name pointing to the VPS
APP_BASE_URL=https://nhuvillas.example.com            # REQUIRED
APP_CORS_ALLOWED_ORIGINS=https://nhuvillas.example.com # REQUIRED

# --- Images (set by the deploy workflow; local builds use :local) ---
BACKEND_IMAGE=ghcr.io/OWNER/hotel-backend:SHA
FRONTEND_IMAGE=ghcr.io/OWNER/hotel-frontend:SHA

# --- Data services ---
DB_PASSWORD=                    # REQUIRED
REDIS_PASSWORD=                 # REQUIRED
RABBITMQ_USER=nhu               # REQUIRED
RABBITMQ_PASSWORD=              # REQUIRED

# --- Admin bootstrap (password: >= 12 chars, upper, lower, digit, symbol) ---
APP_ADMIN_USERNAME=             # REQUIRED
APP_ADMIN_PASSWORD=             # REQUIRED
APP_ADMIN_EMAIL=

# --- Email (required for self-registration, R-12/R-27) ---
APP_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_AUTH_AUTO_VERIFY_WITHOUT_EMAIL=false

# --- Payments ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SEPAY_API_KEY=

# --- AI concierge ---
GEMINI_API_KEY=

# --- Policy knobs (ADR-0009) ---
APP_PRICING_EXTRA_GUEST_FEE=625000
APP_BOOKING_HOLD_MINUTES=15
APP_RATE_LIMIT_SENSITIVE_REQUESTS=10

# --- Monitoring / backup ---
GRAFANA_ADMIN_PASSWORD=         # REQUIRED
BACKUP_HOST_DIR=/srv/nhu-villas/backups
BACKUP_RETENTION_DAYS=14
# Off-site copy (strongly recommended). Receives the dump path as $1. Use SINGLE
# quotes, otherwise Compose interpolates $1 to an empty string:
# BACKUP_OFFSITE_CMD='rclone copy "$1" remote:nhu-villas-backups'
BACKUP_OFFSITE_CMD=

# --- Staging only ---
# NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=
