<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Log level is environment-aware. Defaults to INFO everywhere; override
      via LOG_LEVEL_APP / LOG_LEVEL_SQL / LOG_LEVEL_SECURITY.

      Format (P5):
        * prod / json-logs profiles: one JSON object per line on stdout (Elastic
          Common Schema), incl. the MDC requestId. Containers only log to stdout;
          Docker's json-file driver rotates (docker-compose x-logging).
        * other profiles: human-readable pattern on stdout + rolling file.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n"/>

    <springProfile name="prod | json-logs">
        <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_STDOUT"/>
        </root>
    </springProfile>

    <springProfile name="!(prod | json-logs)">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR:-logs}/hotel-backend.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR:-logs}/hotel-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <logger name="com.hsf.hotel" level="${LOG_LEVEL_APP:-INFO}"/>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_SQL:-WARN}"/>
    <logger name="org.springframework.security" level="${LOG_LEVEL_SECURITY:-INFO}"/>
    <logger name="org.flywaydb" level="INFO"/>
</configuration>
