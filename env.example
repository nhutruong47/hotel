# ============================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ============================================================
# DATABASE (Production)
# ============================================================
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=postgresql://localhost:5432/hotel
SPRING_DATASOURCE_USERNAME=hotel_user
SPRING_DATASOURCE_PASSWORD=your-secure-password

# ============================================================
# ADMIN CREDENTIALS (REQUIRED in production)
# ============================================================
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=YourStrongP@ssw0rd123!

# ============================================================
# APPLICATION BASE URL
# ============================================================
APP_BASE_URL=http://localhost:5173

# ============================================================
# CORS (Comma-separated origins)
# ============================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://yourdomain.com

# ============================================================
# SESSION SECURITY (Set true in production with HTTPS)
# ============================================================
SESSION_COOKIE_SECURE=false

# ============================================================
# STRIPE PAYMENT GATEWAY
# ============================================================
# Get keys from: https://dashboard.stripe.com/apikeys
# Test/live keys must be copied from Stripe Dashboard.
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# ============================================================
# EMAIL (SMTP)
# ============================================================
# Gmail: Enable 2FA, create App Password
# SendGrid: Create API Key
# Mailtrap: Free sandbox for testing
APP_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================================
# GEMINI AI (Optional)
# ============================================================
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================
# RATE LIMITING
# ============================================================
APP_RATE_LIMIT_REQUESTS=120
APP_RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# FRONTEND VARIABLES (for frontend/.env.local)
# ============================================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
