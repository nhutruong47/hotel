<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      Log level is environment-aware. Defaults to INFO everywhere; override
      in dev / prod via LOG_LEVEL_APP (and per-package levels if needed).
      e.g.  LOG_LEVEL_APP=DEBUG  → com.hsf.hotel at DEBUG
            LOG_LEVEL_SQL=WARN   → org.hibernate.SQL at WARN
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-logs}/hotel-backend.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-logs}/hotel-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Default to INFO; env can override via LOG_LEVEL_APP / spring profile. -->
    <logger name="com.hsf.hotel" level="${LOG_LEVEL_APP:-INFO}"/>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_SQL:-WARN}"/>
    <logger name="org.springframework.security" level="${LOG_LEVEL_SECURITY:-INFO}"/>
    <logger name="org.flywaydb" level="INFO"/>
</configuration>
