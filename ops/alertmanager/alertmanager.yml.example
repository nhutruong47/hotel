# Copy to ops/alertmanager/alertmanager.yml (git-ignored: it contains the SMTP
# password) and fill in the values. Validated in CI with `amtool check-config`.
global:
  smtp_smarthost: "smtp.example.com:587"
  smtp_from: "alerts@example.com"
  smtp_auth_username: "alerts@example.com"
  smtp_auth_password: "CHANGE_ME"
  smtp_require_tls: true

route:
  receiver: ops-email
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      receiver: ops-email
      repeat_interval: 1h

receivers:
  - name: ops-email
    email_configs:
      - to: "owner@example.com"
        send_resolved: true

inhibit_rules:
  - source_matchers: ['alertname="PostgresDown"']
    target_matchers: ['alertname=~"BackendDown|HighServerErrorRate"']
